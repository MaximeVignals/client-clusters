{
  "name": "client-clusters",
  "productName": "Client Clusters",
  "version": "1.10.0",
  "description": "Group clients into nearby clusters and track visits",
  "main": "src/main.js",
  "author": "Maxime Vignals <contact@maximevignals.fr>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "node test/run-smoke.cjs",
    "test:ui": "node test/run-ui.cjs",
    "dist:win": "node scripts/build-win.js"
  },
  "build": {
    "appId": "com.clientclusters.app",
    "productName": "Client Clusters",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "7z",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "ClientClusters-${version}-win-x64.${ext}"
    },
    "extraResources": [
      {
        "from": "build/electron-version.txt",
        "to": "electron-version.txt"
      }
    ],
    "extraFiles": [
      {
        "from": "build/update.ps1",
        "to": "update.ps1"
      },
      {
        "from": "build/Update Client Clusters.bat",
        "to": "Update Client Clusters.bat"
      }
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^44.10.1",
    "electron-builder": "^26.18.1",
    "leaflet": "^1.9.4"
  }
}
